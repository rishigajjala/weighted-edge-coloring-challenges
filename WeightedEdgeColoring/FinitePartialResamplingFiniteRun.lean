import WeightedEdgeColoring.FinitePartialResamplingProcess

/-!
# Finite adaptive partial-resampling runs

Fix a deterministic policy selecting one row from every complete state.  A
trace of length `n` records only the `n` partial assignments selected by the
normalized hitting laws.  The row at a step is reconstructed from the table
state exposed after the preceding patches.

Everything in this file is finite.  For a fixed table, trace masses are
nonnegative and sum to one.  Multiplying by the finite table-prefix mass and
summing over both tables and traces again gives one.  Positive trace mass
forces every recorded patch to be compatible with the table state at which
it was selected.

This file does not claim that a run terminates.  The missing witness-history
estimate must bound long traces before a terminating trace can be extracted.
-/

namespace WeightedEdgeColoring.FinitePartialResamplingFiniteRun

open scoped BigOperators
open WeightedEdgeColoring.FinitePartialResamplingExponential
open WeightedEdgeColoring.FinitePartialResamplingProcess

noncomputable section

variable {Source State Row : Type*}
variable [Fintype Source] [DecidableEq Source]
variable [Fintype State] [DecidableEq State]
variable [Fintype Row] [DecidableEq Row]

/-- A length-`n` trace records one selected partial assignment per step. -/
abbrev PatchTrace (Source State : Type*) (n : ℕ) :=
  Fin n → PartialAssignment Source State

/-- Split a nonempty trace into its first patch and remaining trace. -/
def patchTraceSuccEquiv (n : ℕ) :
    PatchTrace Source State (n + 1) ≃
      PartialAssignment Source State × PatchTrace Source State n where
  toFun trace := (trace 0, Fin.tail trace)
  invFun pair := Fin.cons pair.1 pair.2
  left_inv trace := Fin.cons_self_tail trace
  right_inv pair := by
    rcases pair with ⟨head, tail⟩
    simp

/-- Split a finite sum over nonempty traces into the first patch and tail. -/
theorem sum_patchTrace_succ
    (n : ℕ) (f : PatchTrace Source State (n + 1) → ℝ) :
    (∑ trace : PatchTrace Source State (n + 1), f trace) =
      ∑ head : PartialAssignment Source State,
        ∑ tail : PatchTrace Source State n, f (Fin.cons head tail) := by
  calc
    (∑ trace : PatchTrace Source State (n + 1), f trace) =
        ∑ pair : PartialAssignment Source State × PatchTrace Source State n,
          f (Fin.cons pair.1 pair.2) := by
      exact Fintype.sum_equiv (patchTraceSuccEquiv (Source := Source)
        (State := State) n) f (fun pair ↦ f (Fin.cons pair.1 pair.2))
        (fun trace ↦ by
          change f trace = f (Fin.cons (trace 0) (Fin.tail trace))
          rw [Fin.cons_self_tail])
    _ = ∑ head : PartialAssignment Source State,
          ∑ tail : PatchTrace Source State n, f (Fin.cons head tail) := by
      rw [Fintype.sum_prod_type]

/-- Recorded row--patch history generated by an adaptive trace. -/
def traceHistory
    (rowPolicy : (Source → State) → Row)
    (T : ResamplingTable Source State) (p : Pointer Source) :
    (n : ℕ) → PatchTrace Source State n →
      List (ResamplingStep Source State Row)
  | 0, _trace => []
  | n + 1, trace =>
      let Y := trace 0
      let r := rowPolicy (tableChoice T p)
      (r, Y) :: traceHistory rowPolicy T (advancePointer p Y) n (Fin.tail trace)

/-- Normalized adaptive mass of a patch trace for a fixed table. -/
def traceMass
    (weight : Row → PartialAssignment Source State → ℝ)
    (rowPolicy : (Source → State) → Row)
    (T : ResamplingTable Source State) (p : Pointer Source) :
    (n : ℕ) → PatchTrace Source State n → ℝ
  | 0, _trace => 1
  | n + 1, trace =>
      let Y := trace 0
      let z := tableChoice T p
      let r := rowPolicy z
      normalizedPatchWeight weight r z Y *
        traceMass weight rowPolicy T (advancePointer p Y) n (Fin.tail trace)

theorem traceHistory_length
    (rowPolicy : (Source → State) → Row)
    (T : ResamplingTable Source State) (p : Pointer Source) :
    ∀ (n : ℕ) (trace : PatchTrace Source State n),
      (traceHistory rowPolicy T p n trace).length = n := by
  intro n
  induction n generalizing p with
  | zero =>
      intro trace
      simp [traceHistory]
  | succ n ih =>
      intro trace
      simp only [traceHistory, List.length_cons]
      rw [ih (p := advancePointer p (trace 0)) (Fin.tail trace)]

/-- If every policy row has compatible hitting total at least one, every
adaptive trace has nonnegative normalized mass. -/
theorem traceMass_nonneg
    {weight : Row → PartialAssignment Source State → ℝ}
    (hweight : ∀ r Y, 0 ≤ weight r Y)
    (rowPolicy : (Source → State) → Row)
    (htotal : ∀ z, 1 ≤ compatiblePatchTotal weight (rowPolicy z) z)
    (T : ResamplingTable Source State) (p : Pointer Source) :
    ∀ (n : ℕ) (trace : PatchTrace Source State n),
      0 ≤ traceMass weight rowPolicy T p n trace := by
  intro n
  induction n generalizing p with
  | zero =>
      intro trace
      simp [traceMass]
  | succ n ih =>
      intro trace
      let z := tableChoice T p
      let Y := trace 0
      have htotalPos : 0 < compatiblePatchTotal weight (rowPolicy z) z :=
        lt_of_lt_of_le zero_lt_one (htotal z)
      exact mul_nonneg
        (normalizedPatchWeight_nonneg hweight htotalPos Y)
        (ih (p := advancePointer p Y) (Fin.tail trace))

/-- For a fixed table, normalized adaptive trace masses sum exactly to one at
every finite horizon. -/
theorem sum_traceMass
    (weight : Row → PartialAssignment Source State → ℝ)
    (rowPolicy : (Source → State) → Row)
    (htotal : ∀ z, 1 ≤ compatiblePatchTotal weight (rowPolicy z) z)
    (T : ResamplingTable Source State) (p : Pointer Source) :
    ∀ n : ℕ,
      (∑ trace : PatchTrace Source State n,
        traceMass weight rowPolicy T p n trace) = 1 := by
  intro n
  induction n generalizing p with
  | zero =>
      simp [traceMass]
  | succ n ih =>
      rw [sum_patchTrace_succ]
      simp only [traceMass, Fin.cons_zero, Fin.tail_cons]
      calc
        (∑ head : PartialAssignment Source State,
            ∑ tail : PatchTrace Source State n,
              normalizedPatchWeight weight
                  (rowPolicy (tableChoice T p)) (tableChoice T p) head *
                traceMass weight rowPolicy T (advancePointer p head) n tail) =
            ∑ head : PartialAssignment Source State,
              normalizedPatchWeight weight
                  (rowPolicy (tableChoice T p)) (tableChoice T p) head *
                (∑ tail : PatchTrace Source State n,
                  traceMass weight rowPolicy T (advancePointer p head) n tail) := by
          apply Finset.sum_congr rfl
          intro head _hhead
          rw [Finset.mul_sum]
        _ = ∑ head : PartialAssignment Source State,
              normalizedPatchWeight weight
                (rowPolicy (tableChoice T p)) (tableChoice T p) head := by
          apply Finset.sum_congr rfl
          intro head _hhead
          rw [ih (p := advancePointer p head)]
          simp
        _ = 1 := by
          exact sum_normalizedPatchWeight weight
            (ne_of_gt (lt_of_lt_of_le zero_lt_one
              (htotal (tableChoice T p))))

/-- The history reconstructed from a trace always has the policy-row hitting
total at least one at every step. -/
theorem traceHistory_hasHittingTotals
    (weight : Row → PartialAssignment Source State → ℝ)
    (rowPolicy : (Source → State) → Row)
    (htotal : ∀ z, 1 ≤ compatiblePatchTotal weight (rowPolicy z) z)
    (T : ResamplingTable Source State) (p : Pointer Source) :
    ∀ (n : ℕ) (trace : PatchTrace Source State n),
      HasHittingTotalsFrom weight T p
        (traceHistory rowPolicy T p n trace) := by
  intro n
  induction n generalizing p with
  | zero =>
      intro trace
      simp [traceHistory, HasHittingTotalsFrom]
  | succ n ih =>
      intro trace
      exact ⟨htotal (tableChoice T p),
        ih (p := advancePointer p (trace 0)) (Fin.tail trace)⟩

/-- The recursive trace mass is exactly the normalized history mass of its
recorded row--patch list. -/
theorem traceMass_eq_historyPatchMass
    (weight : Row → PartialAssignment Source State → ℝ)
    (rowPolicy : (Source → State) → Row)
    (T : ResamplingTable Source State) (p : Pointer Source) :
    ∀ (n : ℕ) (trace : PatchTrace Source State n),
      traceMass weight rowPolicy T p n trace =
        historyPatchMass weight T p
          (traceHistory rowPolicy T p n trace) := by
  intro n
  induction n generalizing p with
  | zero =>
      intro trace
      simp [traceMass, traceHistory, historyPatchMass]
  | succ n ih =>
      intro trace
      simp only [traceMass, traceHistory, historyPatchMass]
      rw [ih (p := advancePointer p (trace 0)) (Fin.tail trace)]

/-- The normalized mass of a legal trace is bounded by the product of its
unnormalized hitting weights. -/
theorem traceMass_le_historyHittingProduct
    {weight : Row → PartialAssignment Source State → ℝ}
    (hweight : ∀ r Y, 0 ≤ weight r Y)
    (rowPolicy : (Source → State) → Row)
    (htotal : ∀ z, 1 ≤ compatiblePatchTotal weight (rowPolicy z) z)
    (T : ResamplingTable Source State) (p : Pointer Source)
    (n : ℕ) (trace : PatchTrace Source State n) :
    traceMass weight rowPolicy T p n trace ≤
      historyHittingProduct weight
        (traceHistory rowPolicy T p n trace) := by
  rw [traceMass_eq_historyPatchMass]
  exact historyPatchMass_le_historyHittingProduct hweight T p
    (traceHistory rowPolicy T p n trace)
    (traceHistory_hasHittingTotals weight rowPolicy htotal T p n trace)

/-- A positive normalized patch weight must be compatible with the complete
state at which it was selected. -/
theorem compatible_of_normalizedPatchWeight_pos
    (weight : Row → PartialAssignment Source State → ℝ)
    {r : Row} {z : Source → State} {Y : PartialAssignment Source State}
    (hpos : 0 < normalizedPatchWeight weight r z Y) :
    Compatible Y z := by
  by_contra hnot
  rw [normalizedPatchWeight_eq_zero_of_incompatible weight hnot] at hpos
  exact lt_irrefl 0 hpos

/-- Positive adaptive trace mass forces every recorded patch to agree with
the table state exposed immediately before it. -/
theorem traceHistory_realized_of_traceMass_pos
    {weight : Row → PartialAssignment Source State → ℝ}
    (hweight : ∀ r Y, 0 ≤ weight r Y)
    (rowPolicy : (Source → State) → Row)
    (htotal : ∀ z, 1 ≤ compatiblePatchTotal weight (rowPolicy z) z)
    (T : ResamplingTable Source State) (p : Pointer Source) :
    ∀ (n : ℕ) (trace : PatchTrace Source State n),
      0 < traceMass weight rowPolicy T p n trace →
        RealizesFrom T p (traceHistory rowPolicy T p n trace) := by
  intro n
  induction n generalizing p with
  | zero =>
      intro trace hpos
      simp [traceHistory, RealizesFrom]
  | succ n ih =>
      intro trace hpos
      let z := tableChoice T p
      let Y := trace 0
      let headMass := normalizedPatchWeight weight (rowPolicy z) z Y
      let tailMass := traceMass weight rowPolicy T
        (advancePointer p Y) n (Fin.tail trace)
      have htotalPos : 0 < compatiblePatchTotal weight (rowPolicy z) z :=
        lt_of_lt_of_le zero_lt_one (htotal z)
      have hhead0 : 0 ≤ headMass :=
        normalizedPatchWeight_nonneg hweight htotalPos Y
      have htail0 : 0 ≤ tailMass :=
        traceMass_nonneg hweight rowPolicy htotal T
          (advancePointer p Y) n (Fin.tail trace)
      have hproduct : 0 < headMass * tailMass := by
        simpa [traceMass, z, Y, headMass, tailMass] using hpos
      have hheadPos : 0 < headMass := by
        by_contra hnot
        have hheadZero : headMass = 0 :=
          le_antisymm (le_of_not_gt hnot) hhead0
        rw [hheadZero, zero_mul] at hproduct
        exact lt_irrefl 0 hproduct
      have htailPos : 0 < tailMass := by
        by_contra hnot
        have htailZero : tailMass = 0 :=
          le_antisymm (le_of_not_gt hnot) htail0
        rw [htailZero, mul_zero] at hproduct
        exact lt_irrefl 0 hproduct
      have hcompat : Compatible Y z :=
        compatible_of_normalizedPatchWeight_pos weight hheadPos
      exact ⟨hcompat,
        ih (p := advancePointer p Y) (Fin.tail trace) htailPos⟩

/-- Trace history and trace mass specialized to an `n+1`-cell finite table
prefix and the all-zero initial pointer. -/
def finiteTraceHistory
    (rowPolicy : (Source → State) → Row)
    (fallback : Source → State) {n : ℕ}
    (T : FiniteResamplingTable Source State n)
    (trace : PatchTrace Source State n) :
    List (ResamplingStep Source State Row) :=
  traceHistory rowPolicy (extendFiniteTable fallback T)
    initialPointer n trace

def finiteTraceMass
    (weight : Row → PartialAssignment Source State → ℝ)
    (rowPolicy : (Source → State) → Row)
    (fallback : Source → State) {n : ℕ}
    (T : FiniteResamplingTable Source State n)
    (trace : PatchTrace Source State n) : ℝ :=
  traceMass weight rowPolicy (extendFiniteTable fallback T)
    initialPointer n trace

theorem finiteTraceHistory_length
    (rowPolicy : (Source → State) → Row)
    (fallback : Source → State) {n : ℕ}
    (T : FiniteResamplingTable Source State n)
    (trace : PatchTrace Source State n) :
    (finiteTraceHistory rowPolicy fallback T trace).length = n := by
  exact traceHistory_length rowPolicy (extendFiniteTable fallback T)
    initialPointer n trace

theorem finiteTraceMass_nonneg
    {weight : Row → PartialAssignment Source State → ℝ}
    (hweight : ∀ r Y, 0 ≤ weight r Y)
    (rowPolicy : (Source → State) → Row)
    (htotal : ∀ z, 1 ≤ compatiblePatchTotal weight (rowPolicy z) z)
    (fallback : Source → State) {n : ℕ}
    (T : FiniteResamplingTable Source State n)
    (trace : PatchTrace Source State n) :
    0 ≤ finiteTraceMass weight rowPolicy fallback T trace := by
  exact traceMass_nonneg hweight rowPolicy htotal
    (extendFiniteTable fallback T) initialPointer n trace

theorem sum_finiteTraceMass
    (weight : Row → PartialAssignment Source State → ℝ)
    (rowPolicy : (Source → State) → Row)
    (htotal : ∀ z, 1 ≤ compatiblePatchTotal weight (rowPolicy z) z)
    (fallback : Source → State) (n : ℕ)
    (T : FiniteResamplingTable Source State n) :
    (∑ trace : PatchTrace Source State n,
      finiteTraceMass weight rowPolicy fallback T trace) = 1 := by
  exact sum_traceMass weight rowPolicy htotal
    (extendFiniteTable fallback T) initialPointer n

theorem finiteTraceHistory_realized_of_mass_pos
    {weight : Row → PartialAssignment Source State → ℝ}
    (hweight : ∀ r Y, 0 ≤ weight r Y)
    (rowPolicy : (Source → State) → Row)
    (htotal : ∀ z, 1 ≤ compatiblePatchTotal weight (rowPolicy z) z)
    (fallback : Source → State) {n : ℕ}
    (T : FiniteResamplingTable Source State n)
    (trace : PatchTrace Source State n)
    (hpos : 0 < finiteTraceMass weight rowPolicy fallback T trace) :
    RealizesFrom (extendFiniteTable fallback T) initialPointer
      (finiteTraceHistory rowPolicy fallback T trace) := by
  exact traceHistory_realized_of_traceMass_pos hweight rowPolicy htotal
    (extendFiniteTable fallback T) initialPointer n trace hpos

theorem finiteTraceHistory_hasHittingTotals
    (weight : Row → PartialAssignment Source State → ℝ)
    (rowPolicy : (Source → State) → Row)
    (htotal : ∀ z, 1 ≤ compatiblePatchTotal weight (rowPolicy z) z)
    (fallback : Source → State) {n : ℕ}
    (T : FiniteResamplingTable Source State n)
    (trace : PatchTrace Source State n) :
    HasHittingTotalsFrom weight (extendFiniteTable fallback T) initialPointer
      (finiteTraceHistory rowPolicy fallback T trace) := by
  exact traceHistory_hasHittingTotals weight rowPolicy htotal
    (extendFiniteTable fallback T) initialPointer n trace

/-- Product mass of one finite table/trace sample. -/
def finiteRunSampleMass
    (prob : Source → State → ℝ)
    (weight : Row → PartialAssignment Source State → ℝ)
    (rowPolicy : (Source → State) → Row)
    (fallback : Source → State) {n : ℕ}
    (T : FiniteResamplingTable Source State n)
    (trace : PatchTrace Source State n) : ℝ :=
  finiteTableMass prob T * finiteTraceMass weight rowPolicy fallback T trace

theorem finiteRunSampleMass_nonneg
    {prob : Source → State → ℝ} (hprob : ∀ i a, 0 ≤ prob i a)
    {weight : Row → PartialAssignment Source State → ℝ}
    (hweight : ∀ r Y, 0 ≤ weight r Y)
    (rowPolicy : (Source → State) → Row)
    (htotal : ∀ z, 1 ≤ compatiblePatchTotal weight (rowPolicy z) z)
    (fallback : Source → State) {n : ℕ}
    (T : FiniteResamplingTable Source State n)
    (trace : PatchTrace Source State n) :
    0 ≤ finiteRunSampleMass prob weight rowPolicy fallback T trace := by
  exact mul_nonneg (finiteTableMass_nonneg hprob T)
    (finiteTraceMass_nonneg hweight rowPolicy htotal fallback T trace)

/-- All finite table/trace sample masses sum to one. -/
theorem sum_finiteRunSampleMass
    (prob : Source → State → ℝ)
    (hprobSum : ∀ i, ∑ a, prob i a = 1)
    (weight : Row → PartialAssignment Source State → ℝ)
    (rowPolicy : (Source → State) → Row)
    (htotal : ∀ z, 1 ≤ compatiblePatchTotal weight (rowPolicy z) z)
    (fallback : Source → State) (n : ℕ) :
    (∑ T : FiniteResamplingTable Source State n,
      ∑ trace : PatchTrace Source State n,
        finiteRunSampleMass prob weight rowPolicy fallback T trace) = 1 := by
  calc
    (∑ T : FiniteResamplingTable Source State n,
        ∑ trace : PatchTrace Source State n,
          finiteRunSampleMass prob weight rowPolicy fallback T trace) =
        ∑ T : FiniteResamplingTable Source State n,
          finiteTableMass prob T *
            (∑ trace : PatchTrace Source State n,
              finiteTraceMass weight rowPolicy fallback T trace) := by
      apply Finset.sum_congr rfl
      intro T _hT
      unfold finiteRunSampleMass
      rw [Finset.mul_sum]
    _ = ∑ T : FiniteResamplingTable Source State n,
          finiteTableMass prob T := by
      apply Finset.sum_congr rfl
      intro T _hT
      rw [sum_finiteTraceMass weight rowPolicy htotal fallback n T]
      simp
    _ = 1 := sum_finiteTableMass prob hprobSum n

end

end WeightedEdgeColoring.FinitePartialResamplingFiniteRun
