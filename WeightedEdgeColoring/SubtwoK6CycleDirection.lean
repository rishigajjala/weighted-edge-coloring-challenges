def intDirection (j : Fin 105) (e : Edge) : ℤ :=
  if e ∈ (cyclePatterns[j]).1 then 1 else if e ∈ (cyclePatterns[j]).2 then -1 else 0

def direction (j : Fin 105) (e : Edge) : ℝ := intDirection j e

private theorem int_balance :
    ∀ j : Fin 105, ∀ v : Vertex,
      (∑ e : Edge, if v ∈ ends e then intDirection j e else 0) = 0 := by
  decide +kernel

theorem direction_degree_zero (j : Fin 105) (v : Vertex) :
    degree (direction j) v = 0 := by
  rw [degree_eq_incidence_sum]
  simp only [direction]
  exact_mod_cast int_balance j v

private theorem intDirection_nonzero :
    ∀ j : Fin 105, ∃ e : Edge, intDirection j e ≠ 0 := by
  decide +kernel

theorem direction_nonzero (j : Fin 105) : ∃ e : Edge, direction j e ≠ 0 := by
  obtain ⟨e, he⟩ := intDirection_nonzero j
  refine ⟨e, ?_⟩
  simp only [direction]
  exact_mod_cast he

end WeightedEdgeColoring.Subtwo.K6CycleDirection
