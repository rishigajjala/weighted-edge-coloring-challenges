import WeightedEdgeColoring.RankThreeActiveResidualWeight
import WeightedEdgeColoring.RankThreeResidualInvariantStep

/-!
# Finite iteration of active residual rounds

This file contains the deterministic induction that is shared by all later
parameter choices.  A one-round theorem supplies a residual partial matching,
protected job loss, active-slot shrink, and weighted gain.  The induction
lifts and unions the round matchings, transports the degree bounds, and
iterates the affine active-weight recurrence.
-/

namespace WeightedEdgeColoring

/-- The scalar affine recurrence generated by round-dependent coverage rates
and discarded-weight floors. -/
def activeStarAffineBound
    (theta floor : ℕ → ℝ) (initial : ℝ) : ℕ → ℝ
  | 0 => initial
  | t + 1 =>
      (1 - theta t) * activeStarAffineBound theta floor initial t +
        theta t * floor t

/-- If every round uses one coverage rate and every discarded floor is at
most `F`, the affine recurrence has the usual geometric bound with `F` paid
only once. -/
theorem activeStarAffineBound_const_le
    (theta : ℝ) (floor : ℕ → ℝ) (initial F : ℝ)
    (htheta0 : 0 ≤ theta) (htheta1 : theta ≤ 1) (hF0 : 0 ≤ F)
    (hfloor : ∀ t, floor t ≤ F) :
    ∀ n,
      activeStarAffineBound (fun _ ↦ theta) floor initial n ≤
        (1 - theta) ^ n * initial + F := by
  intro n
  induction n with
  | zero =>
      simp [activeStarAffineBound, hF0]
  | succ n ih =>
      rw [activeStarAffineBound]
      have hfactor : 0 ≤ 1 - theta := sub_nonneg.mpr htheta1
      calc
        (1 - theta) *
              activeStarAffineBound (fun _ ↦ theta) floor initial n +
            theta * floor n ≤
            (1 - theta) * ((1 - theta) ^ n * initial + F) +
              theta * F := by
          exact add_le_add (mul_le_mul_of_nonneg_left ih hfactor)
            (mul_le_mul_of_nonneg_left (hfloor n) htheta0)
        _ = (1 - theta) ^ (n + 1) * initial + F := by
          rw [pow_succ]
          ring

namespace RankThreeOptionSystem

universe u v w

variable (G : WeightedSimpleGraph.{u})
  {Slot : Type v} {Option : Type w}
  [Fintype Slot] [Fintype Option]
  [DecidableEq Slot] [DecidableEq Option]
  (H : RankThreeOptionSystem G.E Slot Option)

/-- Variable-parameter finite residual iteration.

The hypotheses `hround` are exactly the four outputs needed from a concrete
probabilistic one-round lemma.  Everything else in this theorem is
deterministic bookkeeping. -/
theorem exists_iterated_active_residual_rounds
    (steps : ℕ)
    (d slotCap jobLoss slotThreshold slotBudget : ℕ → ℕ)
    (theta floor : ℕ → ℝ)
    (htheta0 : ∀ t < steps, 0 ≤ theta t)
    (htheta1 : ∀ t < steps, theta t ≤ 1)
    (hjobNext : ∀ t < steps, d (t + 1) ≤ d t - jobLoss t)
    (hjobPositive : ∀ t < steps, jobLoss t < d t)
    (hthreshold : ∀ t < steps,
      slotThreshold t ≤ slotCap (t + 1) + 1)
    (hslotNext : ∀ t < steps,
      2 * slotCap t ≤ 2 * slotCap (t + 1) + slotBudget t)
    (hlower0 : ∀ o, d 0 ≤ (H.fiber (H.owner o)).card)
    (hupper0 : ∀ s, H.slotDegree s ≤ slotCap 0)
    (hround : ∀ (t : ℕ), t < steps →
      ∀ M : Finset Option, H.IsPartialMatching M →
      (∀ o : H.ResidualOption M,
        d t ≤ ((H.residualSystem M).fiber
          ((H.residualSystem M).owner o)).card) →
      (∀ s, (H.residualSystem M).slotDegree s ≤ slotCap t) →
      ∃ A : Finset (H.ResidualOption M),
        (H.residualSystem M).IsPartialMatching A ∧
        (∀ j, ¬ (H.residualSystem M).Covers A j →
          (H.residualSystem M).residualJobDegree ∅ j ≤
            (H.residualSystem M).residualJobDegree A j + jobLoss t) ∧
        (∀ s : (H.residualSystem M).ActiveSlot (slotThreshold t),
          (∀ p ∈ A, s.1 ∉ (H.residualSystem M).slots p) →
            2 * (H.residualSystem M).residualSlotDegree A s.1 +
                slotBudget t ≤
              2 * (H.residualSystem M).residualSlotDegree ∅ s.1) ∧
        (∀ vtx,
          theta t *
              (G.residualActiveStarWeight H M vtx - floor t) ≤
            ∑ e ∈ (G.activeStarEdgeSet
              (H.residualSystem M).activeJobs vtx).filter
                ((H.residualSystem M).Covers A), G.weight e)) :
    ∃ M : Finset Option,
      H.IsPartialMatching M ∧
      (H.residualSystem M).activeJobs =
        (H.activeJobs.filter fun j ↦ ¬ H.Covers M j) ∧
      (∀ o : H.ResidualOption M,
        d steps ≤ ((H.residualSystem M).fiber
          ((H.residualSystem M).owner o)).card) ∧
      (∀ s, (H.residualSystem M).slotDegree s ≤ slotCap steps) ∧
      ∀ vtx,
        G.residualActiveStarWeight H M vtx ≤
          activeStarAffineBound theta floor
            (G.residualActiveStarWeight H ∅ vtx) steps := by
  have hind : ∀ k : ℕ, k ≤ steps →
      ∃ M : Finset Option,
        H.IsPartialMatching M ∧
        (H.residualSystem M).activeJobs =
          (H.activeJobs.filter fun j ↦ ¬ H.Covers M j) ∧
        (∀ o : H.ResidualOption M,
          d k ≤ ((H.residualSystem M).fiber
            ((H.residualSystem M).owner o)).card) ∧
        (∀ s, (H.residualSystem M).slotDegree s ≤ slotCap k) ∧
        ∀ vtx,
          G.residualActiveStarWeight H M vtx ≤
            activeStarAffineBound theta floor
              (G.residualActiveStarWeight H ∅ vtx) k := by
    intro k hk
    induction k with
    | zero =>
        refine ⟨∅, H.empty_isPartialMatching, ?_, ?_, ?_, ?_⟩
        · rw [H.residualSystem_empty_activeJobs]
          ext j
          simp [Covers]
        · intro o
          change d 0 ≤ ((H.residualSystem ∅).fiber (H.owner o.1)).card
          rw [H.residualSystem_fiber_card, H.residualJobDegree_empty]
          exact hlower0 o.1
        · intro s
          rw [show (H.residualSystem ∅).slotDegree s =
              H.residualSlotDegree ∅ s by
            unfold slotDegree
            exact H.residualSystem_slotDegree_card ∅ s,
            H.residualSlotDegree_empty]
          exact hupper0 s
        · intro vtx
          exact le_rfl
    | succ k ih =>
        have hklt : k < steps := Nat.lt_of_succ_le hk
        rcases ih (Nat.le_of_lt hklt) with
          ⟨M, hM, hactiveM, hlowerM, hupperM, hweightM⟩
        rcases hround k hklt M hM hlowerM hupperM with
          ⟨A, hA, hjobA, hslotA, hgainA⟩
        let M' := M ∪ H.liftResidualSet M A
        have hinv := H.residual_union_degree_invariants
          M A (d k) (jobLoss k) (slotThreshold k) (slotBudget k)
          (slotCap k) (slotCap (k + 1)) hlowerM hjobA hupperM
          (hthreshold k hklt) (hslotNext k hklt) hslotA
        have hactiveNext := H.residual_union_activeJobs_eq_original_filter
          M A (d k) (jobLoss k) hactiveM hlowerM hjobA
          (hjobPositive k hklt)
        refine ⟨M', hM.union_liftResidualSet H hA, hactiveNext, ?_, hinv.2, ?_⟩
        · intro o
          exact (hjobNext k hklt).trans (hinv.1 o)
        · intro vtx
          have hstep := G.residualActiveStarWeight_union_le H
            M A (d k) (jobLoss k) (theta k) (floor k)
            hlowerM hjobA (hjobPositive k hklt) (htheta0 k hklt) hgainA vtx
          have hfactor : 0 ≤ 1 - theta k :=
            sub_nonneg.mpr (htheta1 k hklt)
          calc
            G.residualActiveStarWeight H M' vtx ≤
                (1 - theta k) * G.residualActiveStarWeight H M vtx +
                  theta k * floor k := hstep
            _ ≤ (1 - theta k) *
                    activeStarAffineBound theta floor
                      (G.residualActiveStarWeight H ∅ vtx) k +
                  theta k * floor k := by
              exact add_le_add
                (mul_le_mul_of_nonneg_left (hweightM vtx) hfactor) le_rfl
            _ = activeStarAffineBound theta floor
                  (G.residualActiveStarWeight H ∅ vtx) (k + 1) := rfl
  exact hind steps le_rfl

end RankThreeOptionSystem
end WeightedEdgeColoring
