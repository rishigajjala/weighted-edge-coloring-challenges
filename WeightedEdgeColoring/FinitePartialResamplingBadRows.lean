import WeightedEdgeColoring.FinitePartialResamplingFiniteRun

/-!
# Finite runs when every state has a bad row

This file specializes the finite adaptive-run construction to the
contradiction regime used by a partial-resampling existence proof: every
complete assignment has at least one bad row.  Classical finite choice fixes
one such row as a deterministic policy.  The assumed fractional hitting
property then supplies compatible patch mass at least one at every step.

The resulting finite trace and table/trace laws are normalized, and every
positive-mass trace records a realized history of bad rows.  No assertion is
made that the regime is impossible; that conclusion still requires the
separate witness-history estimate.
-/

namespace WeightedEdgeColoring.FinitePartialResamplingBadRows

open scoped BigOperators
open WeightedEdgeColoring.FinitePartialResamplingExponential
open WeightedEdgeColoring.FinitePartialResamplingProcess
open WeightedEdgeColoring.FinitePartialResamplingFiniteRun

noncomputable section

variable {Source State Row : Type*}
variable [Fintype Source] [DecidableEq Source]
variable [Fintype State] [DecidableEq State]
variable [Fintype Row] [DecidableEq Row]

/-- Deterministically choose one bad row at every complete assignment. -/
def badRowPolicy
    (bad : Row → (Source → State) → Prop)
    (hall : ∀ z, ∃ r, bad r z)
    (z : Source → State) : Row :=
  Classical.choose (hall z)

theorem badRowPolicy_isBad
    (bad : Row → (Source → State) → Prop)
    (hall : ∀ z, ∃ r, bad r z)
    (z : Source → State) :
    bad (badRowPolicy bad hall z) z :=
  Classical.choose_spec (hall z)

/-- A hitting family covers the row selected by `badRowPolicy`. -/
theorem badRowPolicy_compatiblePatchTotal_ge_one
    (bad : Row → (Source → State) → Prop)
    (hall : ∀ z, ∃ r, bad r z)
    (weight : Row → PartialAssignment Source State → ℝ)
    (hhit : ∀ r z, bad r z → 1 ≤ compatiblePatchTotal weight r z)
    (z : Source → State) :
    1 ≤ compatiblePatchTotal weight (badRowPolicy bad hall z) z :=
  hhit (badRowPolicy bad hall z) z (badRowPolicy_isBad bad hall z)

/-- Every recorded row is bad at the table state visible immediately before
that step. -/
def HasBadRowsFrom
    (bad : Row → (Source → State) → Prop)
    (T : ResamplingTable Source State) :
    Pointer Source → List (ResamplingStep Source State Row) → Prop
  | _p, [] => True
  | p, step :: history =>
      bad step.1 (tableChoice T p) ∧
        HasBadRowsFrom bad T (advancePointer p step.2) history

@[simp] theorem hasBadRowsFrom_nil
    (bad : Row → (Source → State) → Prop)
    (T : ResamplingTable Source State) (p : Pointer Source) :
    HasBadRowsFrom bad T p [] := by
  simp [HasBadRowsFrom]

@[simp] theorem hasBadRowsFrom_cons
    (bad : Row → (Source → State) → Prop)
    (T : ResamplingTable Source State) (p : Pointer Source)
    (step : ResamplingStep Source State Row)
    (history : List (ResamplingStep Source State Row)) :
    HasBadRowsFrom bad T p (step :: history) ↔
      bad step.1 (tableChoice T p) ∧
        HasBadRowsFrom bad T (advancePointer p step.2) history := by
  rfl

/-- Every trace generated by the chosen policy records bad rows, independent
of whether the chosen patches have positive mass. -/
theorem traceHistory_hasBadRows
    (bad : Row → (Source → State) → Prop)
    (hall : ∀ z, ∃ r, bad r z)
    (T : ResamplingTable Source State) (p : Pointer Source) :
    ∀ (n : ℕ) (trace : PatchTrace Source State n),
      HasBadRowsFrom bad T p
        (traceHistory (badRowPolicy bad hall) T p n trace) := by
  intro n
  induction n generalizing p with
  | zero =>
      intro trace
      simp [traceHistory, HasBadRowsFrom]
  | succ n ih =>
      intro trace
      exact ⟨badRowPolicy_isBad bad hall (tableChoice T p),
        ih (p := advancePointer p (trace 0)) (Fin.tail trace)⟩

/-- Trace masses for the bad-row policy are nonnegative. -/
theorem badTraceMass_nonneg
    (bad : Row → (Source → State) → Prop)
    (hall : ∀ z, ∃ r, bad r z)
    {weight : Row → PartialAssignment Source State → ℝ}
    (hweight : ∀ r Y, 0 ≤ weight r Y)
    (hhit : ∀ r z, bad r z → 1 ≤ compatiblePatchTotal weight r z)
    (T : ResamplingTable Source State) (p : Pointer Source)
    (n : ℕ) (trace : PatchTrace Source State n) :
    0 ≤ traceMass weight (badRowPolicy bad hall) T p n trace := by
  exact traceMass_nonneg hweight (badRowPolicy bad hall)
    (badRowPolicy_compatiblePatchTotal_ge_one bad hall weight hhit)
    T p n trace

/-- For a fixed table, bad-policy trace masses sum to one at every finite
horizon. -/
theorem sum_badTraceMass
    (bad : Row → (Source → State) → Prop)
    (hall : ∀ z, ∃ r, bad r z)
    (weight : Row → PartialAssignment Source State → ℝ)
    (hhit : ∀ r z, bad r z → 1 ≤ compatiblePatchTotal weight r z)
    (T : ResamplingTable Source State) (p : Pointer Source)
    (n : ℕ) :
    (∑ trace : PatchTrace Source State n,
      traceMass weight (badRowPolicy bad hall) T p n trace) = 1 := by
  exact sum_traceMass weight (badRowPolicy bad hall)
    (badRowPolicy_compatiblePatchTotal_ge_one bad hall weight hhit) T p n

/-- Every bad-policy trace has compatible hitting total at least one along
its recorded history. -/
theorem badTraceHistory_hasHittingTotals
    (bad : Row → (Source → State) → Prop)
    (hall : ∀ z, ∃ r, bad r z)
    (weight : Row → PartialAssignment Source State → ℝ)
    (hhit : ∀ r z, bad r z → 1 ≤ compatiblePatchTotal weight r z)
    (T : ResamplingTable Source State) (p : Pointer Source)
    (n : ℕ) (trace : PatchTrace Source State n) :
    HasHittingTotalsFrom weight T p
      (traceHistory (badRowPolicy bad hall) T p n trace) := by
  exact traceHistory_hasHittingTotals weight (badRowPolicy bad hall)
    (badRowPolicy_compatiblePatchTotal_ge_one bad hall weight hhit)
    T p n trace

/-- Positive bad-policy trace mass forces the recorded history to be
compatible with the resampling table. -/
theorem badTraceHistory_realized_of_mass_pos
    (bad : Row → (Source → State) → Prop)
    (hall : ∀ z, ∃ r, bad r z)
    {weight : Row → PartialAssignment Source State → ℝ}
    (hweight : ∀ r Y, 0 ≤ weight r Y)
    (hhit : ∀ r z, bad r z → 1 ≤ compatiblePatchTotal weight r z)
    (T : ResamplingTable Source State) (p : Pointer Source)
    (n : ℕ) (trace : PatchTrace Source State n)
    (hpos : 0 < traceMass weight (badRowPolicy bad hall) T p n trace) :
    RealizesFrom T p
      (traceHistory (badRowPolicy bad hall) T p n trace) := by
  exact traceHistory_realized_of_traceMass_pos hweight
    (badRowPolicy bad hall)
    (badRowPolicy_compatiblePatchTotal_ge_one bad hall weight hhit)
    T p n trace hpos

/-- A positive bad-policy trace is simultaneously a realized history, a
bad-row history, and a history with valid hitting totals. -/
theorem badTraceHistory_legal_of_mass_pos
    (bad : Row → (Source → State) → Prop)
    (hall : ∀ z, ∃ r, bad r z)
    {weight : Row → PartialAssignment Source State → ℝ}
    (hweight : ∀ r Y, 0 ≤ weight r Y)
    (hhit : ∀ r z, bad r z → 1 ≤ compatiblePatchTotal weight r z)
    (T : ResamplingTable Source State) (p : Pointer Source)
    (n : ℕ) (trace : PatchTrace Source State n)
    (hpos : 0 < traceMass weight (badRowPolicy bad hall) T p n trace) :
    RealizesFrom T p
        (traceHistory (badRowPolicy bad hall) T p n trace) ∧
      HasBadRowsFrom bad T p
        (traceHistory (badRowPolicy bad hall) T p n trace) ∧
      HasHittingTotalsFrom weight T p
        (traceHistory (badRowPolicy bad hall) T p n trace) := by
  exact ⟨badTraceHistory_realized_of_mass_pos bad hall hweight hhit
      T p n trace hpos,
    traceHistory_hasBadRows bad hall T p n trace,
    badTraceHistory_hasHittingTotals bad hall weight hhit T p n trace⟩

/-- Bad-policy trace mass is bounded by its unnormalized hitting-weight
product. -/
theorem badTraceMass_le_historyHittingProduct
    (bad : Row → (Source → State) → Prop)
    (hall : ∀ z, ∃ r, bad r z)
    {weight : Row → PartialAssignment Source State → ℝ}
    (hweight : ∀ r Y, 0 ≤ weight r Y)
    (hhit : ∀ r z, bad r z → 1 ≤ compatiblePatchTotal weight r z)
    (T : ResamplingTable Source State) (p : Pointer Source)
    (n : ℕ) (trace : PatchTrace Source State n) :
    traceMass weight (badRowPolicy bad hall) T p n trace ≤
      historyHittingProduct weight
        (traceHistory (badRowPolicy bad hall) T p n trace) := by
  exact traceMass_le_historyHittingProduct hweight (badRowPolicy bad hall)
    (badRowPolicy_compatiblePatchTotal_ge_one bad hall weight hhit)
    T p n trace

/-- Finite-prefix bad-policy trace masses sum to one. -/
theorem sum_finiteBadTraceMass
    (bad : Row → (Source → State) → Prop)
    (hall : ∀ z, ∃ r, bad r z)
    (weight : Row → PartialAssignment Source State → ℝ)
    (hhit : ∀ r z, bad r z → 1 ≤ compatiblePatchTotal weight r z)
    (fallback : Source → State) (n : ℕ)
    (T : FiniteResamplingTable Source State n) :
    (∑ trace : PatchTrace Source State n,
      finiteTraceMass weight (badRowPolicy bad hall) fallback T trace) = 1 := by
  exact sum_finiteTraceMass weight (badRowPolicy bad hall)
    (badRowPolicy_compatiblePatchTotal_ge_one bad hall weight hhit)
    fallback n T

/-- Positive finite-prefix trace mass gives all three concrete legality
properties for the recorded bad-row history. -/
theorem finiteBadTraceHistory_legal_of_mass_pos
    (bad : Row → (Source → State) → Prop)
    (hall : ∀ z, ∃ r, bad r z)
    {weight : Row → PartialAssignment Source State → ℝ}
    (hweight : ∀ r Y, 0 ≤ weight r Y)
    (hhit : ∀ r z, bad r z → 1 ≤ compatiblePatchTotal weight r z)
    (fallback : Source → State) {n : ℕ}
    (T : FiniteResamplingTable Source State n)
    (trace : PatchTrace Source State n)
    (hpos : 0 < finiteTraceMass weight (badRowPolicy bad hall)
      fallback T trace) :
    RealizesFrom (extendFiniteTable fallback T) initialPointer
        (finiteTraceHistory (badRowPolicy bad hall) fallback T trace) ∧
      HasBadRowsFrom bad (extendFiniteTable fallback T) initialPointer
        (finiteTraceHistory (badRowPolicy bad hall) fallback T trace) ∧
      HasHittingTotalsFrom weight (extendFiniteTable fallback T) initialPointer
        (finiteTraceHistory (badRowPolicy bad hall) fallback T trace) := by
  exact badTraceHistory_legal_of_mass_pos bad hall hweight hhit
    (extendFiniteTable fallback T) initialPointer n trace hpos

/-- All finite table/trace samples under the bad-row policy have total mass
one. -/
theorem sum_finiteBadRunSampleMass
    (prob : Source → State → ℝ)
    (hprobSum : ∀ i, ∑ a, prob i a = 1)
    (bad : Row → (Source → State) → Prop)
    (hall : ∀ z, ∃ r, bad r z)
    (weight : Row → PartialAssignment Source State → ℝ)
    (hhit : ∀ r z, bad r z → 1 ≤ compatiblePatchTotal weight r z)
    (fallback : Source → State) (n : ℕ) :
    (∑ T : FiniteResamplingTable Source State n,
      ∑ trace : PatchTrace Source State n,
        finiteRunSampleMass prob weight (badRowPolicy bad hall)
          fallback T trace) = 1 := by
  exact sum_finiteRunSampleMass prob hprobSum weight
    (badRowPolicy bad hall)
    (badRowPolicy_compatiblePatchTotal_ge_one bad hall weight hhit)
    fallback n

end

end WeightedEdgeColoring.FinitePartialResamplingBadRows
